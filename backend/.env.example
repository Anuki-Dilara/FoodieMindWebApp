PORT=5000
MONGODB_URI=mongodb://localhost:27017/moodmeal-pantry
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
SPOONACULAR_API_KEY=your_spoonacular_api_key
ADMIN_EMAIL=admin@moodmeal.com
ADMIN_PASSWORD=Admin123!

# Password-reset email (SMTP). Without these, /auth/forgot-password returns 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# Public frontend URL used to build password-reset links.
FRONTEND_URL=http://localhost:3000

# Optional dev fallback: 'log' accepts mail without delivering it (never use in production).
# EMAIL_TRANSPORT=log

# AI Pantry Explorer (local Ollama only — no paid providers)
AI_PROVIDER=ollama
AI_ENABLED=true
AI_PANTRY_EXPLORER_ENABLED=true
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_GENERATION_ATTEMPTS=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
